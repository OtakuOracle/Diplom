<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Elbrus.MainWindow"
		x:CompileBindings="True"
		Title="Авторизация"
		Icon="Icon/icon.png">

	<Window.Background>
		<ImageBrush Source="avares://Elbrus/Images/logo.png" Opacity="1" Stretch="UniformToFill"/>
	</Window.Background>
	<DockPanel>
		<StackPanel HorizontalAlignment="Center" DockPanel.Dock="Top" Margin="0,20,0,0">
			<TextBlock Text="Точки проката горнолыжного комплекса «Приэльбрусье»"/>
		</StackPanel>
		<StackPanel Spacing="15" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
			<TextBox Width="300" x:Name="LoginTextBox" Watermark="Введите логин"/>
			<StackPanel Orientation="Horizontal">
				<TextBox Width="260" x:Name="PasswordTextBox" PasswordChar="*" Watermark="Введите пароль"/>
				<Button Click="TogglePasswordVisibility">
					<Image Source="Images/eye.png" Width="20" Height="20"/>
				</Button>
			</StackPanel>
			<StackPanel Spacing="5" Orientation="Horizontal" HorizontalAlignment="Center">
				<Button Content="Войти"
						Click="AuthorizeButton"
						Background="#ADFF2F"
						Padding="20,5"/>
			</StackPanel>
			<TextBlock x:Name="ErrorBlock" Foreground="Red"/>
		</StackPanel>
	</DockPanel>
</Window>